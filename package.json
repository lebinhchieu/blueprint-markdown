{
  "name": "blueprint-markdown-chieu",
  "displayName": "Blueprint Markdown - Chieu",
  "description": "Extends VS Code's built-in Markdown preview with cards, callouts, tabs, steps, timelines, mermaid, and more via ::: directive syntax.",
  "version": "0.5.0",
  "publisher": "ChieuLe",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lebinhchieu/blueprint-markdown"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "directives",
    "callout",
    "cards",
    "blueprint"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "blueprintMarkdown.exportHtml",
        "title": "Export to HTML (single file)",
        "category": "Blueprint Markdown"
      }
    ],
    "grammars": [
      {
        "scopeName": "text.html.markdown.blueprint",
        "path": "./syntaxes/blueprint.injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/reset.css",
      "./media/tokens.css",
      "./media/base.css",
      "./media/components.css",
      "./media/em-theme.css",
      "./media/fonts.css",
      "./media/hljs.css"
    ],
    "markdown.previewScripts": [
      "./dist/preview.js"
    ],
    "configuration": {
      "title": "Blueprint Markdown",
      "properties": {
        "blueprintMarkdown.theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto",
            "neon-synthwave",
            "neon-cyberpunk",
            "neon-vaporwave",
            "aurora",
            "jewel-garden",
            "tropical-sorbet",
            "tropical-sorbet-night"
          ],
          "enumDescriptions": [
            "Warm Artisan light palette (terracotta on parchment)",
            "Warm Artisan dark palette (bright terracotta on near-black)",
            "Follow VS Code's active light/dark theme",
            "Neon synthwave (cyan + magenta on blue-black)",
            "Neon cyberpunk (electric green on black)",
            "Neon vaporwave (purple + pink on violet-black)",
            "Aurora — iridescent orchid pastels on pearl white",
            "Jewel Garden — rich amethyst & emerald gems on ivory",
            "Tropical Sorbet — bright coral & citrus candy on cream",
            "Tropical Sorbet Night — coral & citrus candy on warm cocoa"
          ],
          "default": "light",
          "description": "Color theme for the Blueprint Markdown preview. 'auto' follows VS Code's active theme."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-yarn",
    "publish:ovsx": "ovsx publish",
    "mindmap:build": "node mindmap-viewer/build.mjs",
    "mindmap:watch": "node mindmap-viewer/build.mjs --watch"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.4.1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "*",
    "@fontsource-variable/playfair-display": "*",
    "@fontsource/jetbrains-mono": "*",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.6.0"
  }
}
